{
  "info": {
    "name": "ReqRes API — Smoke & Core",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Users (page=2)",
      "request": {
        "method": "GET",
        "url": "https://reqres.in/api/users?page=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has users array', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET User (id=2)",
      "request": {
        "method": "GET",
        "url": "https://reqres.in/api/users/2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('User schema is valid', function () {",
              "  const data = pm.response.json().data;",
              "  pm.expect(data).to.have.property('id').that.is.a('number');",
              "  pm.expect(data).to.have.property('email').that.is.a('string');",
              "  pm.expect(data).to.have.property('first_name').that.is.a('string');",
              "  pm.expect(data).to.have.property('last_name').that.is.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Login (valid)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"eve.holt@reqres.in\", \"password\": \"cityslicka\" }"
        },
        "url": "https://reqres.in/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Token is returned', function () {",
              "  pm.expect(pm.response.json()).to.have.property('token');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Login (missing password)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"eve.holt@reqres.in\" }"
        },
        "url": "https://reqres.in/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
              "",
              "pm.test('Error message is returned', function () {",
              "  pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
